# Environment Configuration for Skill Link Backend

# Application
APP_NAME=Skill Link Backend
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=skilllink-super-secret-key-change-in-production-2026-xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default to SQLite for seamless local execution without requiring running Postgres service
DATABASE_URL=sqlite:///./careerbridge.db
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/careerbridge

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# AI Providers (optional keys; fallback to deterministic intelligent engine when none provided)
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
