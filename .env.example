# Skill Link Root Environment Configuration
# Copy this file to backend/.env and customize as needed.

# Application
APP_NAME=Skill Link
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=skilllink-super-secret-key-change-in-production-2026-xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite for seamless instant local execution
DATABASE_URL=sqlite:///./careerbridge.db
# PostgreSQL option:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/careerbridge

# Frontend & CORS
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# AI Providers (Demonstration & deterministic engine works out-of-the-box without paid keys)
LLM_PROVIDER=local_intelligent
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
